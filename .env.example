# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/assumption-event?retryWrites=true&w=majority

# next-auth (generate secret with: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# EdgeStore keys from https://dashboard.edgestore.dev (for event image upload)
EDGE_STORE_ACCESS_KEY=
EDGE_STORE_SECRET_KEY=
